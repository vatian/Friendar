# Образец настроек. Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в репозиторий НЕ попадает (он в .gitignore).

# --- Для приложения (эти значения публичные, они попадут в сайт) ---
# Адрес проекта Supabase: Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Публичный ключ Supabase: Project Settings → API Keys → Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=
# Имя бота без @, например FriendarBot
VITE_BOT_USERNAME=

# --- Секреты (только у вас и в Supabase secrets, в сайт НЕ попадают) ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Секретный ключ Supabase: Project Settings → API Keys → Secret key
SUPABASE_SECRET_KEY=
